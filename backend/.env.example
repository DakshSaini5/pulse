# ===========================================================
# PULSE BACKEND — Environment Variables
# ===========================================================
# Copy this file to .env and fill in your real values.
# NEVER commit your .env file to Git!
# ===========================================================

# Server
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS whitelist)
FRONTEND_URL=http://localhost:5173

# Auth — Generate a strong secret: `openssl rand -base64 64`
JWT_SECRET=CHANGE_ME_generate_a_strong_random_secret_here

# Google OAuth 2.0
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Google Gemini AI — Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Database — PostgreSQL connection string (Supabase, Railway, etc.)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres

# Cloudinary — Image/file cloud storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
