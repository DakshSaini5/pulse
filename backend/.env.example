# ===========================================================
# PULSE BACKEND — Environment Variables
# ===========================================================
# Copy this file to .env and fill in your real values.
# NEVER commit your .env file to Git!
# ===========================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS whitelist)
FRONTEND_URL=http://localhost:5173

# Auth — Generate a strong secret: `openssl rand -base64 64`
JWT_SECRET=your_jwt_secret_here

# Google OAuth 2.0 Client Credentials
GOOGLE_CLIENT_ID=your_google_oauth_client_id_here

# Google Gemini AI — Get from https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Database — PostgreSQL connection strings (Supabase, Railway, etc.)
# DATABASE_URL is for query pooling, DIRECT_URL is for direct migrations
DATABASE_URL=postgresql://user:password@host:port/dbname?pgbouncer=true
DIRECT_URL=postgresql://user:password@host:port/dbname

# Cloudinary — Image/file cloud storage
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name_here
CLOUDINARY_API_KEY=your_cloudinary_api_key_here
CLOUDINARY_API_SECRET=your_cloudinary_api_secret_here

# Twilio Emergency SMS Configuration (Optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=your_twilio_phone_number_here

# Resend Mail Service Config (Optional)
RESEND_API_KEY=your_resend_api_key_here

# Firebase Service Account Credentials (JSON string or local JSON filepath)
FIREBASE_SERVICE_ACCOUNT=your_firebase_service_account_json_or_filepath_here
