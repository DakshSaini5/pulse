    "prisma:generate": "prisma generate",
    "prisma:db-push": "prisma db push",
    "prisma:seed": "ts-node prisma/seed.ts",
    "test": "jest --config jest.config.js",
    "seed": "ts-node prisma/seed.ts",
    "seed:real": "ts-node src/scripts/seed-real-data.ts",
    "seed:pbf": "ts-node src/scripts/seed-pbf.ts",
    "pbf:download": "ts-node src/scripts/download-pbf.ts"
  },
  "dependencies": {
    "@google/generative-ai": "^0.21.0",
    "@prisma/client": "^5.10.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^1.41.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.18.2",
    "express-rate-limit": "^8.5.2",
    "google-auth-library": "^10.6.2",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "multer-storage-cloudinary": "^4.0.0",
    "osm-pbf-parser": "^2.3.0",
    "rate-limit-redis": "^5.0.0",
    "redis": "^6.0.0",
    "socket.io": "^4.8.3",
