{
  "name": "pulse-backend",
  "version": "1.0.0",
  "description": "Pulse SaaS Platform Backend Service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "prisma generate && tsc",
